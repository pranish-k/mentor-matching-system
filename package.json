{
  "name": "mentor-matching-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "data:sync": "tsx scripts/sync-data.ts",
    "data:enrich": "tsx scripts/enrich.ts",
    "data:update": "npm run data:sync && npm run data:enrich",
    "typecheck": "tsc --noEmit",
    "eval:search": "tsx eval/search/run.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run eval:search"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "minisearch": "^7.2.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
